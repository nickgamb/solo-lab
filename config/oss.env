# OSS pins. Resolved 2026-09-28 against GitHub releases and `helm show chart`.
# Nothing floats: bump deliberately, one component at a time, and re-run
# `make verify`.

GATEWAY_API_VERSION=v1.6.1        # what kgateway 2.4.5 and agentgateway 1.5.0 build against
GATEWAY_API_CHANNEL=standard      # standard | experimental

METRICS_SERVER_VERSION=3.14.0
CERT_MANAGER_VERSION=v1.21.2
CLOUD_PROVIDER_KIND_VERSION=v0.11.1
CLOUD_PROVIDER_KIND_DIGEST=sha256:40e18b9cd9c798cce40d39ff5c099a4f16a36c268d8e1dda469d73955a35e403
TRUST_MANAGER_VERSION=v0.25.0
KEYCLOAK_VERSION=26.7.4

# Istio ambient (upstream)
ISTIO_VERSION=1.31.1
# Upstream has not published 1.31 charts to the GCS helm repo (404 as of
# 2026-09-28), so charts come from the checksum-verified release tarball.
ISTIO_CHART_SOURCE=tarball
ISTIO_HUB=docker.io/istio
ISTIO_TAG=1.31.1

# kgateway (Envoy): north-south edge
KGATEWAY_VERSION=v2.4.5
KGATEWAY_CRDS_CHART=oci://cr.kgateway.dev/kgateway-dev/charts/kgateway-crds
KGATEWAY_CHART=oci://cr.kgateway.dev/kgateway-dev/charts/kgateway
KGATEWAY_CLASS=kgateway
KGATEWAY_RELEASE=kgateway

# agentgateway: AI / MCP / A2A gateway
AGW_VERSION=v1.6.0
AGW_CRDS_CHART=oci://cr.agentgateway.dev/charts/agentgateway-crds
AGW_CHART=oci://cr.agentgateway.dev/charts/agentgateway
AGW_CLASS=agentgateway
AGW_RELEASE=agentgateway
AGW_PARAMS_KIND=AgentgatewayParameters
AGW_PARAMS_API=agentgateway.dev/v1alpha1
AGW_PARAMS_GROUP=agentgateway.dev
AGW_BACKEND_API=agentgateway.dev/v1alpha1
AGW_BACKEND_KIND=AgentgatewayBackend
AGW_BACKEND_GROUP=agentgateway.dev
AGW_POLICY_KIND=AgentgatewayPolicy
AGW_POLICY_GROUP=agentgateway.dev
AGW_POLICY_API=agentgateway.dev/v1alpha1

# Agent Substrate: the pairing kagent 0.10.x vendors (go.mod replace -> v0.0.9).
# 0.0.13+ needs an out-of-band CA-pool bootstrap step before ate-api starts.
SUBSTRATE_VERSION=0.0.9
SUBSTRATE_LAB_TAG=v0.0.9-lab.1    # tools/substrate-mesh's build of it, in the lab registry
SUBSTRATE_CRDS_CHART=oci://ghcr.io/kagent-dev/substrate/helm/substrate-crds
SUBSTRATE_CHART=oci://ghcr.io/kagent-dev/substrate/helm/substrate

# kagent (+ kmcp 0.3.0 bundled as a subchart)
# 0.10.2 is the stable line. The 1.0.0-alpha train (AgentTemplate/Harness, the
# API kagent-enterprise 1.0 is built on) ships every few days. This lab's
# kagent patches (tools/kagent) are against 0.10.2.
KAGENT_VERSION=0.10.2
KAGENT_LAB_TAG=0.10.2-lab.4       # tools/kagent's build of it, in the lab registry
KAGENT_CRDS_CHART=oci://ghcr.io/kagent-dev/kagent/helm/kagent-crds
KAGENT_CHART=oci://ghcr.io/kagent-dev/kagent/helm/kagent

# Observability
KPS_VERSION=91.8.1                # kube-prometheus-stack
TEMPO_VERSION=1.24.4
OTEL_COLLECTOR_VERSION=0.173.1
KIALI_VERSION=2.32.0
CNPG_VERSION=0.29.1
AGENTREGISTRY_VERSION=0.4.0
AGENTREGISTRY_CHART=oci://ghcr.io/agentregistry-dev/agentregistry/charts/agentregistry
