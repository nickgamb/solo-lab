# Solo Enterprise pins. Sourced ON TOP of oss.env, for products whose
# <PRODUCT>_EDITION=enterprise. Only the keys that differ are set here.
#
# Resolved 2026-09-28 from us-docker.pkg.dev tag lists and ably77's workshops.
# NOT yet exercised in this lab — the first enterprise run should be treated
# as a validation pass (see docs/ENTERPRISE.md).

# Solo Enterprise for Istio (Solo distribution of Istio, ambient)
ENT_ISTIO_VERSION=1.31.1-solo
ENT_ISTIO_CHART_REPO=oci://us-docker.pkg.dev/soloio-img/istio-helm
ENT_ISTIO_HUB=us-docker.pkg.dev/soloio-img/istio
ENT_ISTIO_TAG=1.31.1-solo

# Solo Enterprise for kgateway (was Gloo Gateway 2.x). Versions have no "v".
ENT_KGATEWAY_VERSION=2.3.5
ENT_KGATEWAY_CRDS_CHART=oci://us-docker.pkg.dev/solo-public/enterprise-kgateway/charts/enterprise-kgateway-crds
ENT_KGATEWAY_CHART=oci://us-docker.pkg.dev/solo-public/enterprise-kgateway/charts/enterprise-kgateway
ENT_KGATEWAY_CLASS=enterprise-kgateway
ENT_KGATEWAY_RELEASE=enterprise-kgateway

# Solo Enterprise for agentgateway (CalVer)
ENT_AGW_VERSION=v2026.9.2
ENT_AGW_CRDS_CHART=oci://us-docker.pkg.dev/solo-public/enterprise-agentgateway/charts/enterprise-agentgateway-crds
ENT_AGW_CHART=oci://us-docker.pkg.dev/solo-public/enterprise-agentgateway/charts/enterprise-agentgateway
ENT_AGW_CLASS=enterprise-agentgateway
ENT_AGW_RELEASE=enterprise-agentgateway
ENT_AGW_PARAMS_KIND=EnterpriseAgentgatewayParameters
ENT_AGW_PARAMS_API=enterpriseagentgateway.solo.io/v1alpha1
ENT_AGW_PARAMS_GROUP=enterpriseagentgateway.solo.io
# Enterprise also serves the OSS agentgateway.dev kinds; agentregistry-enterprise
# generates EnterpriseAgentgatewayBackend. Keep OSS kinds until verified.
ENT_AGW_BACKEND_API=agentgateway.dev/v1alpha1
ENT_AGW_BACKEND_KIND=AgentgatewayBackend
ENT_AGW_BACKEND_GROUP=agentgateway.dev
ENT_AGW_POLICY_KIND=EnterpriseAgentgatewayPolicy
ENT_AGW_POLICY_API=enterpriseagentgateway.solo.io/v1alpha1

# Solo Enterprise for kagent. Two tracks exist:
#   ga    0.5.8 + the shared management plane chart (docs.solo.io/kagent)
#   1.0   1.0.0-alpha3 on Agent Substrate 0.2.0-beta5 (themsquared/kagent-enterprise-substrate)
ENT_KAGENT_TRACK=ga
ENT_KAGENT_VERSION=0.5.8
ENT_KAGENT_CRDS_CHART=oci://us-docker.pkg.dev/solo-public/kagent-enterprise-helm/charts/kagent-enterprise-crds
ENT_KAGENT_CHART=oci://us-docker.pkg.dev/solo-public/kagent-enterprise-helm/charts/kagent-enterprise
ENT_MGMT_CHART=oci://us-docker.pkg.dev/solo-public/solo-enterprise-helm/charts/management
ENT_MGMT_VERSION=0.5.8
ENT_SUBSTRATE_VERSION=0.2.0-beta5
