# Lab shape. Non-secret, committed. Override any of these in .env or the shell.

LAB_NAME=${LAB_NAME:-solo-lab}
KIND_NODE_IMAGE=${KIND_NODE_IMAGE:-kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5}
# Workers get topology.kubernetes.io/zone=zone-a|b|c so spread constraints,
# PDBs and Istio locality routing have something real to act on.
KIND_WORKERS=${KIND_WORKERS:-3}

# Host ports for the edge gateway (kind maps these to NodePorts 30080/30443).
# Bound to 127.0.0.1 only. uma4agents also binds 80/443; run one lab at a time
# or move these.
LAB_HTTP_PORT=${LAB_HTTP_PORT:-80}
LAB_HTTPS_PORT=${LAB_HTTPS_PORT:-443}

# Party domains: every hostname is <name>.<party>.lab and resolves the same way
# on the host (make machine-setup -> lab DNS) and in pods (CoreDNS -> edge), so
# issuer URLs mean the same thing everywhere. See docs/ARCHITECTURE.md.
LAB_TLD=${LAB_TLD:-lab}
OPS_DOMAIN=ops.${LAB_TLD}            # platform: observatory, grafana, kiali
SV_DOMAIN=sterling.${LAB_TLD}        # Sterling & Vance (Bob's firm)
ALICE_DOMAIN=alice.${LAB_TLD}        # Alice
MERIDIAN_DOMAIN=meridian.${LAB_TLD}  # Meridian Wealth (Alice's brokerage)
LEDGERLINE_DOMAIN=ledgerline.${LAB_TLD}  # Ledgerline Research (SaaS Bob's firm subscribes to)
# Auth0 as one of S&V's IdPs (ENTERPRISE_IDP): your tenant's issuer, with its
# trailing slash, set in .env with AUTH0_CLIENT_ID and AUTH0_CLIENT_SECRET.
# Unset, auth0 is left out of the chain.
AUTH0_ISSUER=${AUTH0_ISSUER:-}
LAB_DNS_PORT=${LAB_DNS_PORT:-15353}
# The lab CA lives outside the repo and outlives clusters: trust it once.
LAB_CA_DIR=${LAB_CA_DIR:-$HOME/.solo-lab/ca}

# The password grant (username + password straight to the token endpoint) on
# Alice's user-facing client (alice-portal), so make verify and make tour can
# sign her in from a script; people sign in in the browser either way. Bob is
# signed in from a script through the browser flow itself. false turns it off
# (Alice's scripted checks then can't run). Keycloak locks an account out for
# a while after repeated wrong passwords either way.
LAB_PASSWORD_GRANT=${LAB_PASSWORD_GRANT:-true}

# Sterling & Vance's enterprise IdPs: who signs Bob in, in failover order. Each
# is an upstream that S&V's broker (Keycloak at idp.sterling.lab) routes
# sign-ins to and maps into one profile; the broker alone vouches for S&V's
# users to other companies (the ID-JAG for Cross App Access). The first is the primary: the source of truth
# for who exists and their groups. An IdP without an issuer is left out, so a
# fresh clone runs S&V's own two: keycloak (login.sterling.lab, password and a
# second factor) and contingency (login-dr.sterling.lab, password only), both
# installed by layer 45. With every IdP down, only platform admins sign in,
# with the broker's own break-glass accounts (docs/IDENTITY-CONTINUITY.md,
# docs/IDPS.md).
ENTERPRISE_IDP=${ENTERPRISE_IDP:-auth0,keycloak,contingency}

# Every IdP is configured the same way, by its name in ENTERPRISE_IDP (lower
# case; NAME is the same in upper case). Set the first three in .env; the rest
# have defaults below for the IdPs this lab knows (docs/IDPS.md):
#   NAME_ISSUER             its issuer, as its discovery states it
#   NAME_CLIENT_ID          S&V's client there (redirect URI
#                           https://idp.sterling.lab/realms/sterling-vance/broker/<name>/endpoint)
#   NAME_CLIENT_SECRET      none: S&V authenticates with its keys (private_key_jwt,
#                           make xaa-keys: sv-upstream-client.jwks.json)
#   NAME_DISPLAY_NAME       its name on sign-in pages and in the Observatory
#   NAME_GROUPS_CLAIM       the claim its groups (or roles) arrive in; default groups
#   NAME_ASSURANCE          what its sign-ins prove (NIST 800-63B), by the acr or
#                           amr it asserts (JSON); none: AAL1
#   NAME_DIRECTORY_TYPE     the directory sync's access to its users: scim,
#                           auth0 or keycloak; none: no directory
#   NAME_DIRECTORY_URL, NAME_DIRECTORY_CLIENT_ID, NAME_DIRECTORY_CLIENT_SECRET,
#   NAME_DIRECTORY_SCOPES, NAME_DIRECTORY_AUDIENCE
#                           a client_credentials client allowed to read users (and,
#                           for a failover, update them); lab:<NAME>_SECRET names a
#                           secret the lab generates (.lab/secrets.env)

# auth0: roles reach the ID token only through a post-login Action, under a
# namespaced claim; the Management API is its directory
AUTH0_DISPLAY_NAME=${AUTH0_DISPLAY_NAME:-Auth0}
AUTH0_GROUPS_CLAIM=${AUTH0_GROUPS_CLAIM:-https://${SV_DOMAIN}/groups}
AUTH0_ASSURANCE=${AUTH0_ASSURANCE:-'{"levels": [{"amr": "mfa", "level": "AAL2"},
  {"acr": "http://schemas.openid.net/pape/policies/2007/06/multi-factor", "level": "AAL2"}], "default": "AAL1"}'}
AUTH0_DIRECTORY_TYPE=${AUTH0_DIRECTORY_TYPE:-auth0}
AUTH0_DIRECTORY_URL=${AUTH0_DIRECTORY_URL:-${AUTH0_ISSUER:+${AUTH0_ISSUER%/}/api/v2}}
AUTH0_DIRECTORY_AUDIENCE=${AUTH0_DIRECTORY_AUDIENCE:-${AUTH0_ISSUER:+${AUTH0_ISSUER%/}/api/v2/}}
# gluu (Janssen): passkeys (acr fido2) by default; SCIM is its directory
GLUU_DISPLAY_NAME=${GLUU_DISPLAY_NAME:-Gluu}
GLUU_ASSURANCE=${GLUU_ASSURANCE:-'{"levels": [{"acr": "fido2", "level": "AAL2", "phishingResistant": true}], "default": "AAL1"}'}
GLUU_DIRECTORY_TYPE=${GLUU_DIRECTORY_TYPE:-scim}
GLUU_DIRECTORY_URL=${GLUU_DIRECTORY_URL:-${GLUU_ISSUER:+${GLUU_ISSUER%/}/jans-scim/restv1/v2}}
GLUU_DIRECTORY_SCOPES=${GLUU_DIRECTORY_SCOPES:-https://jans.io/scim/users.read https://jans.io/scim/groups.read}
# okta: acr values from its authentication policies (phr: phishing-resistant)
OKTA_DISPLAY_NAME=${OKTA_DISPLAY_NAME:-Okta}
OKTA_ASSURANCE=${OKTA_ASSURANCE:-'{"levels": [{"acr": "urn:okta:loa:2fa:any", "level": "AAL2"},
  {"acr": "phr", "level": "AAL2", "phishingResistant": true}, {"acr": "phrh", "level": "AAL3", "phishingResistant": true}], "default": "AAL1"}'}
# ping: MFA by amr; a SCIM 2.0 endpoint is its directory (set its URL)
PING_DISPLAY_NAME=${PING_DISPLAY_NAME:-Ping Identity}
PING_ASSURANCE=${PING_ASSURANCE:-'{"levels": [{"amr": "mfa", "level": "AAL2"}], "default": "AAL1"}'}
PING_DIRECTORY_TYPE=${PING_DIRECTORY_TYPE:-scim}
# keycloak: the Keycloak S&V runs itself (layer 45), or another realm
KEYCLOAK_ISSUER=${KEYCLOAK_ISSUER:-https://login.${SV_DOMAIN}/realms/workforce}
KEYCLOAK_CLIENT_ID=${KEYCLOAK_CLIENT_ID:-sterling-vance-broker}
KEYCLOAK_DISPLAY_NAME=${KEYCLOAK_DISPLAY_NAME:-Sterling & Vance (Keycloak)}
KEYCLOAK_ASSURANCE=${KEYCLOAK_ASSURANCE:-'{"levels": [{"acr": "aal1", "level": "AAL1"}, {"acr": "aal2", "level": "AAL2"}], "default": "AAL1"}'}
if [ "$KEYCLOAK_ISSUER" = "https://login.${SV_DOMAIN}/realms/workforce" ]; then
  KEYCLOAK_DIRECTORY_TYPE=${KEYCLOAK_DIRECTORY_TYPE:-keycloak}
  KEYCLOAK_DIRECTORY_URL=${KEYCLOAK_DIRECTORY_URL:-http://keycloak.sv-workforce.svc/admin/realms/workforce}
  KEYCLOAK_DIRECTORY_CLIENT_ID=${KEYCLOAK_DIRECTORY_CLIENT_ID:-continuity-directory}
  KEYCLOAK_DIRECTORY_CLIENT_SECRET=${KEYCLOAK_DIRECTORY_CLIENT_SECRET:-lab:SV_WORKFORCE_DIRECTORY_SECRET}
fi
# contingency: the password-only IdP S&V keeps for when its own is down
CONTINGENCY_ISSUER=${CONTINGENCY_ISSUER:-https://login-dr.${SV_DOMAIN}/realms/contingency}
CONTINGENCY_CLIENT_ID=${CONTINGENCY_CLIENT_ID:-sterling-vance-broker}
CONTINGENCY_DISPLAY_NAME=${CONTINGENCY_DISPLAY_NAME:-Sterling & Vance (contingency)}
CONTINGENCY_ASSURANCE=${CONTINGENCY_ASSURANCE:-'{"levels": [{"acr": "aal1", "level": "AAL1"}], "default": "AAL1"}'}
if [ "$CONTINGENCY_ISSUER" = "https://login-dr.${SV_DOMAIN}/realms/contingency" ]; then
  CONTINGENCY_DIRECTORY_TYPE=${CONTINGENCY_DIRECTORY_TYPE:-keycloak}
  CONTINGENCY_DIRECTORY_URL=${CONTINGENCY_DIRECTORY_URL:-http://keycloak.sv-contingency.svc/admin/realms/contingency}
  CONTINGENCY_DIRECTORY_CLIENT_ID=${CONTINGENCY_DIRECTORY_CLIENT_ID:-continuity-directory}
  CONTINGENCY_DIRECTORY_CLIENT_SECRET=${CONTINGENCY_DIRECTORY_CLIENT_SECRET:-lab:SV_CONTINGENCY_DIRECTORY_SECRET}
fi
# The shape S&V's broker maps every IdP into: its groups, and the workforce's
# email domain. Who exists and who is in which group come from the primary IdP
# (the first in ENTERPRISE_IDP): the directory sync gives the broker an
# account for each of its users under the domain, and every IdP's groups (or
# roles) map into these by name, read from the claim NAME_GROUPS_CLAIM
# (docs/IDENTITY-CONTINUITY.md#groups).
SV_GROUPS=${SV_GROUPS:-advisors,platform-engineers,compliance}
SV_EMAIL_DOMAINS=${SV_EMAIL_DOMAINS:-${SV_DOMAIN}}
SV_SYNC_SCHEDULE="${SV_SYNC_SCHEDULE:-*/15 * * * *}"   # the directory sync, unless operators set their own
# the directory sync removes a broker account (and its failover accounts) the
# primary IdP no longer has, or has disabled; false keeps them (profiles
# preloaded at the broker for a demo, a primary without a directory yet)
SV_SYNC_REMOVE_MISSING=${SV_SYNC_REMOVE_MISSING:-true}
# Ledgerline's authorization server, which redeems S&V's ID-JAGs, by its name
# in RESOURCE_AS and configured the same way under LEDGERLINE_ (NAME in upper
# case; docs/IDPS.md):
#   LEDGERLINE_NAME_ISSUER     its issuer, as its discovery states it. One under
#                              .lab is Ledgerline's own Keycloak, which the lab runs
#   LEDGERLINE_NAME_CLIENT_ID  S&V's client there, which the broker's ID-JAGs name
#                              (client_id); default sterling-vance-kagent
RESOURCE_AS=${RESOURCE_AS:-keycloak}
LEDGERLINE_KEYCLOAK_ISSUER=${LEDGERLINE_KEYCLOAK_ISSUER:-https://idp.${LEDGERLINE_DOMAIN}/realms/ledgerline}
_as=LEDGERLINE_$(echo "$RESOURCE_AS" | tr '[:lower:]' '[:upper:]')
_v=${_as}_ISSUER; LEDGERLINE_AS_ISSUER=${!_v:-}            # the ID-JAG's audience
_v=${_as}_CLIENT_ID; SV_CLIENT_AT_LEDGERLINE=${!_v:-sterling-vance-kagent}
unset _as _v

# Local push registry for images you build (docker push localhost:<port>/foo).
LAB_REGISTRY_PORT=${LAB_REGISTRY_PORT:-5001}
# Docker's socket as the Docker daemon sees it (cloud-provider-kind mounts it).
# Rootless Docker: $XDG_RUNTIME_DIR/docker.sock.
LAB_DOCKER_SOCK=${LAB_DOCKER_SOCK:-/var/run/docker.sock}

# Edition: oss | enterprise. Per-product overrides let you move one product to
# enterprise at a time as license keys arrive (e.g. AGW_EDITION=enterprise).
EDITION=${EDITION:-oss}
ISTIO_EDITION=${ISTIO_EDITION:-$EDITION}
KGATEWAY_EDITION=${KGATEWAY_EDITION:-$EDITION}
AGW_EDITION=${AGW_EDITION:-$EDITION}
KAGENT_EDITION=${KAGENT_EDITION:-$EDITION}
AGENTREGISTRY_EDITION=${AGENTREGISTRY_EDITION:-$EDITION}
# the S&V group(s) that may browse agentregistry's catalog (platform-admins
# administer it); space-separated
AGENTREGISTRY_READERS=${AGENTREGISTRY_READERS:-advisors}

# The token an MCP server accepts. Agents reach MCP servers only through
# agentgateway, which verifies the user's token, decides per tool, and sends
# the server a short-lived token of its own making, for that server alone:
# minted by agentgateway's STS (Enterprise), or exchanged at S&V's broker
# (OSS, which has no STS). An MCP server trusts this issuer only.
if [ "$AGW_EDITION" = enterprise ]; then
  MCP_TOKEN_ISSUER=${MCP_TOKEN_ISSUER:-http://enterprise-agentgateway.agentgateway-system.svc.cluster.local:7777}
  # the STS's keys, read-only through the ai-gateway (only the gateway may
  # reach the STS itself: platform/40-agentgateway/sts.yaml)
  MCP_TOKEN_JWKS=${MCP_TOKEN_JWKS:-http://ai-gateway.agentgateway-system.svc.cluster.local/sts/jwks.json}
else
  MCP_TOKEN_ISSUER=${MCP_TOKEN_ISSUER:-https://idp.${SV_DOMAIN}/realms/sterling-vance}
  MCP_TOKEN_JWKS=${MCP_TOKEN_JWKS:-http://keycloak.sv-identity.svc/realms/sterling-vance/protocol/openid-connect/certs}
fi
MCP_TOKEN_LIFETIME=${MCP_TOKEN_LIFETIME:-5s}     # whole seconds, e.g. 5s
MCP_TOKEN_LIFETIME_S=${MCP_TOKEN_LIFETIME%s}      # the same for Keycloak (OSS)

# Istio mesh identity. Matches the kind cluster name minus "kind-": a mismatch
# silently breaks waypoints.
MESH_NAME=${MESH_NAME:-$LAB_NAME}
MESH_NETWORK=${MESH_NETWORK:-${LAB_NAME}-net}
