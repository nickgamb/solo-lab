{
  "realm": "ledgerline",
  "bruteForceProtected": true,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "permanentLockout": false,
  "displayName": "Ledgerline Research",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "identityProviders": [
    {
      "alias": "sterling-vance",
      "displayName": "Sterling & Vance (enterprise IdP)",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "linkOnly": false,
      "config": {
        "issuer": "https://idp.${SV_DOMAIN}/realms/sterling-vance",
        "jwksUrl": "https://idp.${SV_DOMAIN}/realms/sterling-vance/protocol/openid-connect/certs",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "authorizationUrl": "https://idp.${SV_DOMAIN}/realms/sterling-vance/protocol/openid-connect/auth",
        "tokenUrl": "https://idp.${SV_DOMAIN}/realms/sterling-vance/protocol/openid-connect/token",
        "clientId": "ledgerline",
        "jwtAuthorizationGrantEnabled": "true",
        "jwtAuthorizationGrantAssertionReuseAllowed": "false",
        "jwtAuthorizationGrantMaxAllowedAssertionExpiration": "300",
        "clientAuthMethod": "private_key_jwt",
        "clientAssertionSigningAlg": "PS256",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "defaultScope": "openid email profile",
        "filteredByClaim": "true",
        "claimFilterName": "email",
        "claimFilterValue": ".*@${SV_DOMAIN}",
        "syncMode": "IMPORT"
      },
      "firstBrokerLoginFlowAlias": "enterprise first sign-in"
    }
  ],
  "users": [
    {
      "id": "11ed0000-0000-4000-8000-000000000b0b",
      "username": "bob@sterling.lab",
      "email": "bob@${SV_DOMAIN}",
      "firstName": "Bob",
      "lastName": "Reyes",
      "enabled": true,
      "emailVerified": true
    }
  ],
  "clients": [
    {
      "clientId": "sterling-vance-kagent",
      "name": "Sterling & Vance agent platform (Cross App Access client)",
      "description": "Redeems ID-JAGs from S&V's enterprise IdPs (RFC 7523 jwt-bearer), authenticating with S&V's key (private_key_jwt). No interactive login.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "oauth2.jwt.authorization.grant.enabled": "true",
        "oauth2.jwt.authorization.grant.idp": "sterling-vance",
        "jwt.credential.certificate": "${SV_XAA_CLIENT_CERT}",
        "jwt.credential.kid": "${SV_XAA_CLIENT_KID}",
        "use.jwks.url": "false",
        "access.token.lifespan": "300"
      },
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "research:read"
      ]
    },
    {
      "clientId": "ledgerline-research",
      "name": "Ledgerline Research MCP (audience only)",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false
    }
  ],
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "lab-rs256",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "priority": [
            "200"
          ],
          "enabled": [
            "true"
          ],
          "active": [
            "true"
          ],
          "algorithm": [
            "RS256"
          ],
          "privateKey": [
            "${KC_REALM_RSA_KEY}"
          ],
          "certificate": [
            "${KC_REALM_RSA_CERT}"
          ]
        }
      },
      {
        "name": "sso-client-ps256",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "priority": [
            "100"
          ],
          "enabled": [
            "true"
          ],
          "active": [
            "true"
          ],
          "algorithm": [
            "PS256"
          ],
          "privateKey": [
            "${LL_SSO_CLIENT_KEY}"
          ],
          "certificate": [
            "${LL_SSO_CLIENT_CERT}"
          ]
        }
      }
    ]
  },
  "authenticationFlows": [
    {
      "alias": "enterprise first sign-in",
      "description": "First sign-in through a customer's enterprise IdP: a new account, or the existing seat with that email (the IdP is trusted for its own domain only)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-create-user-if-unique",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "idp-auto-link",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "identityProviderMappers": [
    {
      "name": "username from email",
      "identityProviderAlias": "sterling-vance",
      "identityProviderMapper": "oidc-username-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "template": "${CLAIM.email}"
      }
    }
  ],
  "clientScopes": [
