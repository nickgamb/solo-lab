      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://registry.${SV_DOMAIN}/*"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr",
        "continuity-assurance"
      ],
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "aud-agentregistry",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "agentregistry",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "serviceAccountsEnabled": true,
      "description": "Its service account is how the registry calls the kagent controller (its kagent runtime)."
    },
    {
      "clientId": "kagent-ui",
      "name": "Solo UI (kagent, agentgateway, mesh): its own PKCE login, on Enterprise",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "https://kagent.${SV_DOMAIN}/*"
      ],
      "webOrigins": [
        "https://kagent.${SV_DOMAIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://kagent.${SV_DOMAIN}/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "aud-kagent",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "kagent",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "aud-ai-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ai-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "aud-mcp-waypoint",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mcp-waypoint",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "aud-xaa-egress",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "xaa-egress",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "idp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "identity_provider",
            "claim.name": "idp",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr",
        "continuity-assurance"
      ]
    },
    {
      "clientId": "agentregistry-ui",
      "name": "agentregistry-enterprise UI (its own PKCE login)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://registry.${SV_DOMAIN}/*"
      ],
      "webOrigins": [
        "https://registry.${SV_DOMAIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://registry.${SV_DOMAIN}/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "aud-agentregistry",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "agentregistry",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr",
        "continuity-assurance"
      ]
    },
    {
      "clientId": "continuity-controller",
      "name": "identity continuity controller (upstream IdPs + login redirector)",
      "enabled": true,
      "publicClient": false,
      "secret": "${SV_CONTINUITY_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "access.token.lifespan": "120"
      },
      "fullScopeAllowed": false
    },
    {
      "clientId": "continuity-sync",
      "name": "identity continuity profile sync (users' profile attributes; no credentials)",
      "enabled": true,
      "publicClient": false,
      "secret": "${SV_CONTINUITY_SYNC_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "access.token.lifespan": "120"
      },
      "fullScopeAllowed": false
    },
    {
      "clientId": "observatory",
      "name": "Observatory (reads Agent Substrate status from kagent)",
      "enabled": true,
      "publicClient": false,
      "secret": "${SV_OBSERVATORY_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false
    },
    {
      "clientId": "agentregistry-catalog",
      "name": "agentregistry catalog publisher",
      "description": "Publishes what the lab runs (agents, their instructions and MCP servers) to agentregistry's catalog (scripts/registry.sh). Client credentials only; its service account is a platform admin there.",
      "enabled": true,
      "publicClient": false,
      "secret": "${SV_AGENTREGISTRY_CATALOG_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "access.token.lifespan": "300"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "aud-agentregistry",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "agentregistry",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "fullScopeAllowed": false
    }
  ],
  "browserFlow": "continuity-browser",
  "authenticationFlows": [
    {
      "alias": "continuity-browser",
      "description": "SSO cookie, else the active upstream IdP (the continuity controller sets the redirector), else S&V's own login form",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorConfig": "continuity",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": false
        },
        {
          "flowAlias": "continuity-browser forms",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "continuity-browser forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "continuity-first-broker-login",
      "description": "Upstream IdPs only authenticate: link to the existing S&V user by verified email, never create one, never an account with role local-only",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-detect-existing-broker-user",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false
        },
        {
          "authenticator": "idp-auto-link",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false
        },
        {
          "flowAlias": "continuity-first-broker-login local-only",
          "requirement": "CONDITIONAL",
          "priority": 30,
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "continuity-first-broker-login local-only",
      "description": "Refuse the link for an account with role local-only",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "local-only",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false
        },
        {
          "authenticator": "deny-access-authenticator",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "continuity",
      "config": {}
    },
    {
      "alias": "local-only",
      "config": {
        "condUserRole": "local-only",
        "negate": "false"
      }
    }
  ],
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "lab-rs256",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "priority": [
            "200"
          ],
          "enabled": [
            "true"
          ],
          "active": [
            "true"
          ],
          "algorithm": [
            "RS256"
          ],
          "privateKey": [
            "${KC_REALM_RSA_KEY}"
          ],
          "certificate": [
            "${KC_REALM_RSA_CERT}"
          ]
        }
      },
      {
        "name": "upstream-client-ps256",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "priority": [
            "100"
          ],
          "enabled": [
            "true"
          ],
          "active": [
            "true"
          ],
          "algorithm": [
            "PS256"
          ],
          "privateKey": [
            "${SV_BROKER_CLIENT_KEY}"
          ],
          "certificate": [
            "${SV_BROKER_CLIENT_CERT}"
          ]
        }
      }
    ]
  },
  "clientScopes": [
    {
      "name": "organization",
      "description": "Additional claims about the organization a subject belongs to",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "consent.screen.text": "${organizationScopeConsentText}",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-membership-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "organization",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "name": "saml_organization",
      "description": "Organization Membership",
      "protocol": "saml",
      "attributes": {
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "organization",
          "protocol": "saml",
          "protocolMapper": "saml-organization-membership-mapper",
          "consentRequired": false,
          "config": {}
        }
      ]
    },
    {
      "name": "AuthnContextClassRef",
      "description": "AuthnContextClassRef Level of Authentiation",
      "protocol": "saml",
      "attributes": {},
      "protocolMappers": [
        {
          "name": "AuthnContextClassRef",
          "protocol": "saml",
          "protocolMapper": "saml-authn-context-class-ref-mapper",
          "consentRequired": false,
          "config": {}
        }
      ]
    },
    {
      "name": "web-origins",
      "description": "OpenID Connect scope for add allowed web origins to the access token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "consent.screen.text": "",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "allowed web origins",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-allowed-origins-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "basic",
