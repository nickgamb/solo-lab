{
  "realm": "sterling-vance",
  "displayName": "Sterling & Vance",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 3600,
  "groups": [
    {
      "name": "advisors"
    },
    {
      "name": "platform-admins"
    }
  ],
  "users": [
    {
      "username": "bob",
      "email": "bob@${SV_DOMAIN}",
      "firstName": "Bob",
      "lastName": "Reyes",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "bob-demo",
          "temporary": false
        }
      ],
      "groups": [
        "advisors"
      ],
      "id": "5b0b0000-0000-4000-8000-000000000b0b"
    },
    {
      "username": "ops",
      "email": "ops@${SV_DOMAIN}",
      "firstName": "Platform",
      "lastName": "Ops",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "ops-demo",
          "temporary": false
        }
      ],
      "groups": [
        "platform-admins"
      ],
      "id": "5b0b0000-0000-4000-8000-0000000000a5"
    }
  ],
  "clients": [
    {
      "clientId": "kagent",
      "name": "kagent (SSO at the kgateway edge)",
      "enabled": true,
      "publicClient": false,
      "secret": "${SV_KAGENT_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "https://kagent.${SV_DOMAIN}/oauth2/redirect"
      ],
      "webOrigins": [
        "https://kagent.${SV_DOMAIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://kagent.${SV_DOMAIN}/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "aud-ai-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ai-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "aud-mcp-waypoint",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mcp-waypoint",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "ai-gateway",
      "name": "agentgateway (token exchange requester)",
      "enabled": true,
      "publicClient": false,
      "secret": "${SV_AIGW_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "standard.token.exchange.enabled": "true",
        "access.token.lifespan": "120"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mcp-waypoint",
      "name": "sv-mcp waypoint (agentgateway): token exchange for S&V tools",
      "enabled": true,
      "publicClient": false,
      "secret": "${SV_MCP_WAYPOINT_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "standard.token.exchange.enabled": "true",
        "access.token.lifespan": "120"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "aud-bob-workspace",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "bob-workspace",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "bob-workspace",
      "name": "Bob's workspace MCP (audience only)",
      "enabled": true,
      "publicClient": false,
      "secret": "${SV_UNUSED_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "grafana",
      "name": "Grafana",
      "enabled": true,
      "publicClient": false,
      "secret": "${SV_GRAFANA_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://grafana.${OPS_DOMAIN}/login/generic_oauth"
      ],
      "webOrigins": [
        "https://grafana.${OPS_DOMAIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://grafana.${OPS_DOMAIN}/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "lab-rs256",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "priority": [
            "200"
          ],
          "enabled": [
            "true"
          ],
          "active": [
            "true"
          ],
          "algorithm": [
            "RS256"
          ],
          "privateKey": [
            "${KC_REALM_RSA_KEY}"
          ],
          "certificate": [
            "${KC_REALM_RSA_CERT}"
          ]
        }
      }
    ]
  }
}
