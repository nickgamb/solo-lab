{
  "realm": "sterling-vance",
  "bruteForceProtected": true,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "permanentLockout": false,
  "displayName": "Sterling & Vance",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 3600,
  "groups": [
    {
      "name": "platform-admins",
      "realmRoles": [
        "local-only"
      ]
    }
  ],
  "users": [
    {
      "username": "ops",
      "email": "ops@${SV_DOMAIN}",
      "firstName": "Platform",
      "lastName": "Ops",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "ops-demo",
          "temporary": false
        }
      ],
      "groups": [
        "platform-admins"
      ],
      "id": "5b0b0000-0000-4000-8000-0000000000a5"
    },
    {
      "username": "service-account-continuity-controller",
      "enabled": true,
      "serviceAccountClientId": "continuity-controller",
      "clientRoles": {
        "realm-management": [
          "manage-identity-providers",
          "manage-realm",
          "view-clients"
        ]
      },
      "id": "5b0b0000-0000-4000-8000-0000000000c0"
    },
    {
      "username": "service-account-continuity-sync",
      "enabled": true,
      "serviceAccountClientId": "continuity-sync",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users"
        ]
      },
      "id": "5b0b0000-0000-4000-8000-0000000000c1"
    },
    {
      "username": "service-account-agentregistry-catalog",
      "enabled": true,
      "serviceAccountClientId": "agentregistry-catalog",
      "groups": [
        "platform-admins"
      ],
      "id": "5b0b0000-0000-4000-8000-0000000000c4"
    },
    {
      "username": "service-account-agentregistry",
      "enabled": true,
      "serviceAccountClientId": "agentregistry",
      "id": "5b0b0000-0000-4000-8000-0000000000c5"
    }
  ],
  "clients": [
    {
      "clientId": "kagent",
      "name": "kagent (SSO at the kgateway edge)",
      "enabled": true,
      "publicClient": false,
      "secret": "${SV_KAGENT_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://kagent.${SV_DOMAIN}/oauth2/redirect"
      ],
      "webOrigins": [
        "https://kagent.${SV_DOMAIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://kagent.${SV_DOMAIN}/*",
        "standard.token.exchange.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "aud-ai-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ai-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "aud-mcp-waypoint",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mcp-waypoint",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "aud-xaa-egress",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "xaa-egress",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "idp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "identity_provider",
            "claim.name": "idp",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "role_list",
        "saml_organization",
        "AuthnContextClassRef",
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr",
        "basic",
        "continuity-assurance"
      ],
      "optionalClientScopes": [
        "offline_access",
        "address",
        "phone",
        "microprofile-jwt",
        "organization",
        "xaa-ledgerline",
        "research:read"
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "xaa-egress",
      "name": "S&V egress: stored upstream tokens",
      "description": "Reads users' stored upstream tokens (Identity Brokering API v2) for the IdPs that vouch for them, and nothing else. Authenticates with the egress's own key (private_key_jwt).",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "attributes": {
        "external.token.enabled": "true",
        "external.token.idp": "${XAA_UPSTREAMS}",
        "use.jwks.url": "false",
        "jwt.credential.certificate": "${SV_EGRESS_CLIENT_CERT}",
        "jwt.credential.kid": "${SV_EGRESS_CLIENT_KID}",
        "token.endpoint.auth.signing.alg": "RS256"
      },
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "ai-gateway",
      "name": "ai-gateway (audience only: the tokens agents present to it)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false
    },
    {
      "clientId": "mcp-waypoint",
      "name": "sv-mcp waypoint (agentgateway): token exchange for S&V tools",
      "enabled": true,
      "publicClient": false,
      "secret": "${SV_MCP_WAYPOINT_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "standard.token.exchange.enabled": "true",
        "access.token.lifespan": "120"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "aud-bob-workspace",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "bob-workspace",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "bob-workspace",
      "name": "Bob's workspace MCP (audience only)",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false
    },
    {
      "clientId": "${LEDGERLINE_AS_ISSUER}",
      "name": "Ledgerline Research (resource authorization server)",
      "description": "Target of Cross App Access. Its clientId is the resource AS issuer, which becomes the ID-JAG audience.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false
    },
    {
      "clientId": "ledgerline",
      "name": "Ledgerline Research (SSO)",
      "description": "Ledgerline signs S&V users in with S&V's IdP. Ledgerline authenticates with its own key (private_key_jwt).",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "https://idp.${LEDGERLINE_DOMAIN}/realms/ledgerline/broker/sterling-vance/endpoint"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "use.jwks.url": "true",
        "jwks.url": "https://idp.${LEDGERLINE_DOMAIN}/realms/ledgerline/protocol/openid-connect/certs",
        "token.endpoint.auth.signing.alg": "PS256"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "continuity-assurance"
      ],
      "optionalClientScopes": [],
      "fullScopeAllowed": false
    },
    {
      "clientId": "agentregistry",
      "name": "agentregistry (SSO at the kgateway edge)",
      "enabled": true,
      "publicClient": false,
      "secret": "${SV_AGENTREGISTRY_CLIENT_SECRET}",
