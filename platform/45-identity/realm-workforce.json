  "clients": [
    {
      "clientId": "sterling-vance-broker",
      "name": "Sterling & Vance broker",
      "description": "S&V's broker (Keycloak at idp.sterling.lab) signs workforce users in here. It authenticates with its key, and its egress with the egress's key (private_key_jwt; JWKS set by layer 45). The egress gets ID-JAGs for the broker's sign-ins.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "https://idp.${SV_DOMAIN}/realms/sterling-vance/broker/keycloak/endpoint"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "standard.token.exchange.enabled": "true",
        "use.jwks.string": "true",
        "jwks.string": "",
        "use.refresh.tokens": "true",
        "default.acr.values": "aal2",
        "minimum.acr.value": "aal2"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "acr",
        "web-origins"
      ],
      "optionalClientScopes": [
        "xaa-ledgerline",
        "research:read"
      ],
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "aud-self",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "sterling-vance-broker",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "${LEDGERLINE_AS_ISSUER}",
      "name": "Ledgerline Research (resource authorization server)",
      "description": "Target of Cross App Access. Its clientId is the resource AS issuer, which becomes the ID-JAG audience.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false
    },
    {
      "clientId": "ledgerline",
      "name": "Ledgerline Research (SSO)",
      "description": "Ledgerline signs S&V users in with this IdP. Ledgerline authenticates with its own key (private_key_jwt).",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "https://idp.${LEDGERLINE_DOMAIN}/realms/ledgerline/broker/sterling-vance-keycloak/endpoint"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "use.jwks.url": "true",
        "jwks.url": "https://idp.${LEDGERLINE_DOMAIN}/realms/ledgerline/protocol/openid-connect/certs",
        "token.endpoint.auth.signing.alg": "PS256"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "optionalClientScopes": [],
      "fullScopeAllowed": false
    },
    {
      "clientId": "continuity-directory",
      "name": "S&V directory sync (users' profiles; no credentials)",
      "description": "The broker's scheduled directory sync reads users here when this IdP is the primary, and updates or creates them (never a credential) when it's a failover.",
      "enabled": true,
      "publicClient": false,
      "secret": "${SV_WORKFORCE_DIRECTORY_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "access.token.lifespan": "120"
      },
      "fullScopeAllowed": false
    }
  ],
  "clientScopes": [
    {
      "name": "organization",
      "description": "Additional claims about the organization a subject belongs to",
      "protocol": "openid-connect",
      "attributes": {
