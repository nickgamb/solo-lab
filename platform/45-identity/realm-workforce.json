  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "continuity-directory",
        "roles": [
          "view-users",
          "manage-users"
        ]
      }
    ]
  },
  "authenticationFlows": [
    {
      "alias": "aal-browser",
      "description": "SSO cookie, else sign-in by level of authentication (acr.loa.map): aal1 = Level 1 (aal1): password, aal2 = Level 2 (aal2): a one-time code from the user's authenticator app (TOTP), after level 1",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": false
        },
        {
          "flowAlias": "aal-browser levels",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "aal-browser levels",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "flowAlias": "aal-browser aal1",
          "requirement": "CONDITIONAL",
          "priority": 10,
          "authenticatorFlow": true
        },
        {
          "flowAlias": "aal-browser aal2",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "aal-browser aal1",
      "description": "Level 1 (aal1): password",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "aal1",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false
        },
        {
          "authenticator": "auth-username-password-form",
          "authenticatorConfig": "aal1-amr",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "aal-browser aal2",
      "description": "Level 2 (aal2): a one-time code from the user's authenticator app (TOTP), after level 1",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "aal2",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "aal2-amr",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "aal1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "43200"
      }
    },
    {
      "alias": "aal1-amr",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "43200"
      }
    },
    {
      "alias": "aal2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "43200"
      }
    },
    {
      "alias": "aal2-amr",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "43200"
      }
    }
  ]
