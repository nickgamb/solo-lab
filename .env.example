# Copy to .env (gitignored). Everything here is optional.

# --- LLM provider -------------------------------------------------------------
# agentgateway holds the provider credential; kagent and every agent talk to
# agentgateway, never to the provider. Switch with:  make llm LLM_PROVIDER=anthropic
LLM_PROVIDER=ollama                 # ollama | anthropic | openai
# A second provider the gateway fails over to when the first answers 5xx or
# not at all. Its model defaults to that provider's *_MODEL below; for a
# second Ollama model set LLM_FALLBACK_MODEL (any model you pulled).
# LLM_FALLBACK=                     # ollama | anthropic | openai
# LLM_FALLBACK_MODEL=

# Ollama runs on this machine (natively, for the GPU). The cluster finds it
# on its own: host.docker.internal with Docker Desktop, the kind network's
# gateway with Docker Engine. Set OLLAMA_URL only to point somewhere else.
OLLAMA_MODEL=qwen3.8:27b
# OLLAMA_URL=http://host.docker.internal:11434

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Solo Enterprise ------------------------------------------------------------
# Everything runs OSS unless set here. EDITION=enterprise switches every
# product; <PRODUCT>_EDITION switches one. docs/ENTERPRISE.md has the details.
# EDITION=enterprise
# ISTIO_EDITION=enterprise
# KGATEWAY_EDITION=enterprise
# AGW_EDITION=enterprise
# KAGENT_EDITION=enterprise
# AGENTREGISTRY_EDITION=enterprise

# One key for everything, or per product (trial keys are often product-scoped).
SOLO_LICENSE_KEY=
# SOLO_AGW_LICENSE_KEY=
# SOLO_KGATEWAY_LICENSE_KEY=
# SOLO_ISTIO_LICENSE_KEY=
# SOLO_KAGENT_LICENSE_KEY=
# SOLO_AGENTREGISTRY_LICENSE_KEY=

# --- Enterprise IdP and resource AS (config/lab.env) ---------------------------
# ENTERPRISE_IDP: S&V's IdPs in failover order (okta, auth0, gluu, keycloak:
# the Keycloak S&V runs itself). RESOURCE_AS: Ledgerline's authorization server.
# ENTERPRISE_IDP=auth0,keycloak
# RESOURCE_AS=keycloak
# RESOURCE_AS_ISSUER=                 # RESOURCE_AS=gluu: Ledgerline's Gluu, e.g. https://ledger-demo.gluu.info

# --- Upstream IdPs, brokered by S&V's broker (platform/47-continuity) ----------
# Each needs a confidential OIDC client whose redirect URI is
#   https://idp.sterling.lab/realms/sterling-vance/broker/<name>/endpoint
# With no <NAME>_CLIENT_SECRET, S&V authenticates with its keys
# (private_key_jwt): register the JWKS from make xaa-keys
# (sv-upstream-client.jwks.json). Without an issuer the IdP is left out of the
# chain; without a client ID it is NotConfigured. Changing these:
# re-run make layer-47.
AUTH0_ISSUER=                       # e.g. https://your-tenant.us.auth0.com/
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Auth0 as a directory for the directory sync (docs/IDENTITY-CONTINUITY.md):
# a Machine to Machine app for the Auth0 Management API, read:users and
# update:users
AUTH0_DIRECTORY_CLIENT_ID=
AUTH0_DIRECTORY_CLIENT_SECRET=
# Gluu as S&V's enterprise IdP, experimental (docs/GLUU.md): private_key_jwt, no secret
GLUU_ISSUER=
GLUU_CLIENT_ID=
# Okta: an OIDC app integration (web, client credentials off), private_key_jwt
OKTA_ISSUER=                        # e.g. https://your-org.okta.com
OKTA_CLIENT_ID=
# keycloak: S&V's own Keycloak; layer 45 runs one at login.sterling.lab.
# Point these at another Keycloak realm to use that instead.
# KEYCLOAK_ISSUER=https://login.sterling.lab/realms/workforce
# KEYCLOAK_CLIENT_ID=sterling-vance-broker
