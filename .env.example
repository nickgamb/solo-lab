# Copy to .env (gitignored). Everything here is optional.

# --- LLM provider -------------------------------------------------------------
# agentgateway holds the provider credential; kagent and every agent talk to
# agentgateway, never to the provider. Switch with:  make llm LLM_PROVIDER=anthropic
LLM_PROVIDER=ollama                 # ollama | anthropic | openai | bedrock
# Providers the gateway fails over to, in order, when the one before answers
# 5xx or not at all (comma-separated). Each model defaults to that provider's
# *_MODEL below; LLM_FALLBACK_MODEL takes one per fallback, comma-separated,
# empty for the default (a second Ollama model: any model you pulled).
# LLM_FALLBACK=                     # e.g. openai,ollama
# LLM_FALLBACK_MODEL=               # e.g. ,qwen3.8:14b

# Ollama runs on this machine (natively, for the GPU). The cluster finds it
# on its own: host.docker.internal with Docker Desktop, the kind network's
# gateway with Docker Engine. Set OLLAMA_URL only to point somewhere else.
OLLAMA_MODEL=qwen3.8:27b
# OLLAMA_URL=http://host.docker.internal:11434

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Amazon Bedrock: a Bedrock API key, or AWS credentials the gateway signs
# with (a session token too if they are temporary). Anthropic models on
# Bedrock need the account's use case details submitted first.
BEDROCK_API_KEY=
# BEDROCK_AWS_ACCESS_KEY_ID=
# BEDROCK_AWS_SECRET_ACCESS_KEY=
# BEDROCK_AWS_SESSION_TOKEN=
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-6
BEDROCK_REGION=us-east-1

# --- Datadog (optional, docs/DATADOG.md) ------------------------------------------
# A Datadog API key sends a copy of the lab's telemetry to Datadog: traces to
# APM, the GenAI spans to LLM Observability, metrics and logs. Apply with
# make layer-20; remove the key and run it again to stop.
# DATADOG_API_KEY=
# DATADOG_SITE=datadoghq.com
# DATADOG_ENV=lab
# DATADOG_LLMOBS_APP=solo-lab

# --- Solo Enterprise ------------------------------------------------------------
# Everything runs OSS unless set here. EDITION=enterprise switches every
# product; <PRODUCT>_EDITION switches one. docs/ENTERPRISE.md has the details.
# EDITION=enterprise
# ISTIO_EDITION=enterprise
# KGATEWAY_EDITION=enterprise
# AGW_EDITION=enterprise
# KAGENT_EDITION=enterprise
# AGENTREGISTRY_EDITION=enterprise

# One key for everything, or per product (trial keys are often product-scoped).
SOLO_LICENSE_KEY=
# SOLO_AGW_LICENSE_KEY=
# SOLO_KGATEWAY_LICENSE_KEY=
# SOLO_ISTIO_LICENSE_KEY=
# SOLO_KAGENT_LICENSE_KEY=
# SOLO_AGENTREGISTRY_LICENSE_KEY=

# --- S&V's IdPs and Ledgerline's authorization server (docs/IDPS.md) ----------
# ENTERPRISE_IDP: S&V's IdPs in failover order, by name; the first is the
# primary. An IdP without an issuer is left out, so a fresh clone runs S&V's
# own two (keycloak, contingency). Each IdP is configured by its name:
# NAME_ISSUER, NAME_CLIENT_ID, NAME_CLIENT_SECRET (none: S&V authenticates
# with its keys, make xaa-keys), and optionally NAME_DIRECTORY_* for the
# directory sync, NAME_GROUPS_CLAIM, NAME_ASSURANCE, ... (config/lab.env has
# the defaults). Register S&V's client with the redirect URI
#   https://idp.sterling.lab/realms/sterling-vance/broker/<name>/endpoint
# Changing these: make layer-47, then ./demos/bob/install.sh.
# ENTERPRISE_IDP=auth0,keycloak,contingency
#
# RESOURCE_AS: Ledgerline's authorization server, by name, configured the same
# way under LEDGERLINE_: LEDGERLINE_NAME_ISSUER, LEDGERLINE_NAME_CLIENT_ID, and
# LEDGERLINE_NAME_CLIENT_SECRET for an AS that takes no client keys (descope).
# Default keycloak, Ledgerline's own, which the lab runs; gluu, auth0 and
# descope are described in docs/IDPS.md.
# RESOURCE_AS=gluu
# LEDGERLINE_GLUU_ISSUER=           # e.g. https://ledger-demo.gluu.info
# LEDGERLINE_GLUU_CLIENT_ID=        # S&V's client there (the ID-JAGs name it)
#
# MCP_PUBLIC_URL: the front door as AI clients reach it (Enterprise: the OAuth
# issuer publishes its URLs from it); a public https host for parties outside
# the lab. Default https://mcp.sterling.lab.
# MCP_PUBLIC_URL=https://mcp.example.com
# MCP_CIMD_TRUSTED_DOMAINS=          # hosts client ID metadata documents may come from; empty: any public host
#
# XAA_VOUCHER: who issues the ID-JAG, per session: S&V's broker (default), or
# IdPs by name, comma-separated (gluu, okta), each for its own
# sign-ins, with the broker for every other session. Changing it: make
# layer-45 layer-47 layer-80, then ./demos/bob/install.sh.
# XAA_VOUCHER=gluu
# GLUU_XAA_CLIENT_ID=               # S&V's client for ID-JAGs there; default its
#                                   # sign-in client

# auth0: a Regular Web Application; its Management API is its directory
AUTH0_ISSUER=                       # e.g. https://your-tenant.us.auth0.com/
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_DIRECTORY_CLIENT_ID=          # a Machine to Machine app for the Management API
AUTH0_DIRECTORY_CLIENT_SECRET=
# gluu: Gluu Flex / Janssen; passkeys; SCIM is its directory
GLUU_ISSUER=
GLUU_CLIENT_ID=
GLUU_DIRECTORY_CLIENT_ID=
GLUU_DIRECTORY_CLIENT_SECRET=
# okta: an OIDC web app integration with a public key
# (sv-upstream-client-es256.jwks.json); to vouch, the AI agent's linked app
OKTA_ISSUER=                        # e.g. https://your-org.okta.com
OKTA_CLIENT_ID=
# ping: an OIDC web application; a SCIM 2.0 endpoint is its directory
PING_ISSUER=                        # e.g. https://auth.pingone.com/<environment>/as
PING_CLIENT_ID=
PING_DIRECTORY_URL=
PING_DIRECTORY_CLIENT_ID=
PING_DIRECTORY_CLIENT_SECRET=
# keycloak, contingency: S&V's own, which layer 45 runs at login.sterling.lab
# and login-dr.sterling.lab. Point keycloak at another realm to use that instead.
# KEYCLOAK_ISSUER=https://login.sterling.lab/realms/workforce
# KEYCLOAK_CLIENT_ID=sterling-vance-broker
