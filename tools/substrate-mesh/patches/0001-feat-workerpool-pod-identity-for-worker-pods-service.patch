diff --git a/cmd/atecontroller/internal/controllers/workerpool_apply.go b/cmd/atecontroller/internal/controllers/workerpool_apply.go
index faa94f5..2e80b58 100644
--- a/cmd/atecontroller/internal/controllers/workerpool_apply.go
+++ b/cmd/atecontroller/internal/controllers/workerpool_apply.go
@@ -75,13 +75,26 @@ func buildDeploymentApplyConfig(wp *atev1alpha1.WorkerPool) *appsv1ac.Deployment
 			WithReplicas(wp.Spec.Replicas).
 			WithSelector(metav1ac.LabelSelector().
 				WithMatchLabels(map[string]string{"ate.dev/worker-pool": wp.Name})).
-			WithTemplate(corev1ac.PodTemplateSpec().
-				WithLabels(map[string]string{
-					"ate.dev/worker-pool": wp.Name,
-				}).
+			WithTemplate(podTemplateMetaApply(corev1ac.PodTemplateSpec(), wp).
 				WithSpec(podSpecAC)))
 }
 
+// podTemplateMetaApply sets the worker pod labels and annotations: the pool's
+// template metadata, with the selector label always owned by the pool.
+func podTemplateMetaApply(ac *corev1ac.PodTemplateSpecApplyConfiguration, wp *atev1alpha1.WorkerPool) *corev1ac.PodTemplateSpecApplyConfiguration {
+	labels := map[string]string{}
+	if tmpl := wp.Spec.Template; tmpl != nil {
+		for k, v := range tmpl.Labels {
+			labels[k] = v
+		}
+		if len(tmpl.Annotations) > 0 {
+			ac.WithAnnotations(tmpl.Annotations)
+		}
+	}
+	labels["ate.dev/worker-pool"] = wp.Name
+	return ac.WithLabels(labels)
+}
