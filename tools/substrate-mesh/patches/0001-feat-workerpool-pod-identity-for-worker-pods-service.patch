@@ -209,6 +209,29 @@ func TestBuildDeploymentApplyConfig(t *testing.T) {
 	}
 }
 
+// TestWorkerPoolPodIdentity asserts the pod template's identity fields reach
+// the worker pods, and that the pool's selector label can't be overridden.
+func TestWorkerPoolPodIdentity(t *testing.T) {
+	wp := testWorkerPoolApplyConfig(&atev1alpha1.WorkerPoolPodTemplate{
+		ServiceAccountName: "agent-sa",
+		Labels:             map[string]string{"team": "advisors", "ate.dev/worker-pool": "other"},
+		Annotations:        map[string]string{"istio.io/reroute-virtual-interfaces": "ateom0"},
+	})
+	got := buildDeploymentApplyConfig(wp).Spec.Template
+
+	if sa := got.Spec.ServiceAccountName; sa == nil || *sa != "agent-sa" {
+		t.Errorf("serviceAccountName = %v, want agent-sa", sa)
+	}
+	wantLabels := map[string]string{"team": "advisors", "ate.dev/worker-pool": wp.Name}
+	if diff := cmp.Diff(wantLabels, got.Labels); diff != "" {
+		t.Errorf("labels mismatch (-want +got):\n%s", diff)
+	}
+	wantAnnotations := map[string]string{"istio.io/reroute-virtual-interfaces": "ateom0"}
+	if diff := cmp.Diff(wantAnnotations, got.Annotations); diff != "" {
+		t.Errorf("annotations mismatch (-want +got):\n%s", diff)
+	}
+}
