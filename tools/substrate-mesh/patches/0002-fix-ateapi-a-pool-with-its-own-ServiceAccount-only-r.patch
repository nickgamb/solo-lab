+
+// poolAdmitsNamespace reports whether a worker's pool may run actors from
+// ActorTemplates in namespace ns. A pool that runs as its own ServiceAccount
+// lends that workload identity to every actor it runs, and worker selectors
+// match labels across namespaces, so such a pool only admits templates from
+// its own namespace. Pools on the default ServiceAccount stay shareable.
+func (s *AssignWorkerStep) poolAdmitsNamespace(worker *ateapipb.Worker, ns string) bool {
+	if worker.GetWorkerNamespace() == ns {
+		return true
+	}
+	wp, err := s.workerPoolLister.WorkerPools(worker.GetWorkerNamespace()).Get(worker.GetWorkerPool())
+	if err != nil {
+		return false
+	}
+	return wp.Spec.Template == nil || wp.Spec.Template.ServiceAccountName == ""
 }
 
 func (s *AssignWorkerStep) Name() string { return "AssignWorker" }
@@ -139,7 +156,7 @@ func (s *AssignWorkerStep) Execute(ctx context.Context, input *ResumeInput, stat
 		if err != nil {
 			return fmt.Errorf("while checking worker eligibility: %w", err)
 		}
-		if eligible {
+		if eligible && s.poolAdmitsNamespace(worker, state.ActorTemplate.Namespace) {
