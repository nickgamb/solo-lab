+
+func TestAssignWorkerStep_PoolAdmitsNamespace(t *testing.T) {
+	indexer := cache.NewIndexer(cache.MetaNamespaceKeyFunc, cache.Indexers{cache.NamespaceIndex: cache.MetaNamespaceIndexFunc})
+	for _, wp := range []*atev1alpha1.WorkerPool{
+		{ObjectMeta: metav1.ObjectMeta{Namespace: "platform", Name: "shared"}},
+		{
+			ObjectMeta: metav1.ObjectMeta{Namespace: "team-a", Name: "agent"},
+			Spec: atev1alpha1.WorkerPoolSpec{
+				Template: &atev1alpha1.WorkerPoolPodTemplate{ServiceAccountName: "agent"},
+			},
+		},
+	} {
+		if err := indexer.Add(wp); err != nil {
+			t.Fatalf("indexer.Add: %v", err)
+		}
+	}
+	step := &AssignWorkerStep{workerPoolLister: listersv1alpha1.NewWorkerPoolLister(indexer)}
+
+	tests := []struct {
+		name   string
+		worker *ateapipb.Worker
+		ns     string
+		want   bool
+	}{
+		{"shared pool, other namespace", &ateapipb.Worker{WorkerNamespace: "platform", WorkerPool: "shared"}, "team-b", true},
+		{"identity pool, own namespace", &ateapipb.Worker{WorkerNamespace: "team-a", WorkerPool: "agent"}, "team-a", true},
+		{"identity pool, other namespace", &ateapipb.Worker{WorkerNamespace: "team-a", WorkerPool: "agent"}, "team-b", false},
+		{"unknown pool, other namespace", &ateapipb.Worker{WorkerNamespace: "team-c", WorkerPool: "gone"}, "team-b", false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := step.poolAdmitsNamespace(tt.worker, tt.ns); got != tt.want {
+				t.Errorf("poolAdmitsNamespace() = %t, want %t", got, tt.want)
+			}
+		})
+	}
+}
