 	templateSelector *metav1.LabelSelector,
 	actorSelector *ateapipb.Selector,
@@ -224,7 +242,7 @@ func (s *AssignWorkerStep) findFreeWorker(
 		if err != nil {
 			return nil, err
 		}
-		if !eligible {
+		if !eligible || !s.poolAdmitsNamespace(worker, templateNamespace) {
 			continue
 		}
 		if len(nodesRestrictions) == 0 || slices.Contains(nodesRestrictions, worker.GetNodeName()) {
