+// serveActorInbound relays connections to the worker pod's actor port to the
+// active actor. A userspace relay, rather than a PREROUTING DNAT, means inbound
+// traffic reaches a local socket like any other pod's: whatever the CNI or a
+// service mesh does to inbound connections (mTLS termination, authorization,
+// source-IP preservation through transparent sockets) keeps working, because
+// the connection it delivers ends here and not on a forwarded interface.
+//
+// The worker runs at most one actor at a time, so the relay always dials the
+// actor veth IP; with no active actor the dial fails and the connection closes.
+func serveActorInbound(ctx context.Context, port int) error {
+	lis, err := net.Listen("tcp", net.JoinHostPort("", strconv.Itoa(port)))
+	if err != nil {
+		return err
+	}
+	go func() {
+		<-ctx.Done()
+		lis.Close()
+	}()
+	go func() {
+		for {
+			conn, err := lis.Accept()
+			if err != nil {
+				if errors.Is(err, net.ErrClosed) {
+					return
+				}
+				slog.WarnContext(ctx, "Actor inbound accept failed", slog.Any("err", err))
+				continue
+			}
+			go relayToActor(ctx, conn, port)
+		}
+	}()
+	return nil
+}
+
+func relayToActor(ctx context.Context, in net.Conn, port int) {
+	defer in.Close()
+	d := net.Dialer{Timeout: 5 * time.Second}
+	out, err := d.DialContext(ctx, "tcp", net.JoinHostPort(actorVethIP, strconv.Itoa(port)))
+	if err != nil {
+		slog.DebugContext(ctx, "Actor inbound dial failed", slog.Any("err", err))
+		return
+	}
+	defer out.Close()
+
+	done := make(chan struct{}, 2)
+	pipe := func(dst, src net.Conn) {
+		_, _ = io.Copy(dst, src)
+		if tc, ok := dst.(*net.TCPConn); ok {
+			_ = tc.CloseWrite()
+		}
+		done <- struct{}{}
+	}
+	go pipe(out, in)
+	go pipe(in, out)
+	<-done
+	<-done
+}
