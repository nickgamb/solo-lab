+++ b/go/core/internal/a2a/substrate_sandbox_transport_test.go
@@ -14,6 +14,49 @@ import (
 	"github.com/kagent-dev/kagent/go/core/internal/dbtest"
 )
 
+func TestSessionTurns_SuspendNeverLandsOnANewerTurn(t *testing.T) {
+	t.Parallel()
+	var turns sessionTurns
+
+	// A suspend scheduled while a newer turn is in flight is skipped.
+	turns.begin("s")
+	ran := false
+	turns.suspendIdle("s", func() { ran = true })
+	if ran {
+		t.Fatal("suspend ran while a turn was in flight")
+	}
+	turns.end("s")
+	turns.suspendIdle("s", func() { ran = true })
+	if !ran {
+		t.Fatal("suspend skipped with no turn in flight")
+	}
+
+	// A turn that arrives during a suspend waits for it to finish.
+	inSuspend, release := make(chan struct{}), make(chan struct{})
+	var suspended atomic.Bool
+	go turns.suspendIdle("s", func() {
+		close(inSuspend)
+		<-release
+		suspended.Store(true)
+	})
+	<-inSuspend
+	started := make(chan struct{})
+	go func() {
+		turns.begin("s")
+		close(started)
+	}()
+	select {
+	case <-started:
+		t.Fatal("turn started during a suspend")
+	default:
+	}
+	close(release)
+	<-started
+	if !suspended.Load() {
+		t.Fatal("turn started before the suspend finished")
+	}
+}
+
 func TestSuspendSessionActorOnClose(t *testing.T) {
 	t.Parallel()
 
