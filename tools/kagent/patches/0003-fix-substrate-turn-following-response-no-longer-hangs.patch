From a3f49ce22ed4ebbb21347bfbae0fcac57084a910 Mon Sep 17 00:00:00 2001
From: Nick Gamb <nick.gamb@solo.io>
Date: Mon, 28 Sep 2026 14:41:20 -0700
Subject: [PATCH] fix(substrate): a turn that follows a response closely no
 longer hangs

When a SandboxAgent response closes, the controller schedules a suspend of
the session actor. A next message sent right away (a HITL approval, say)
races it:

- if the turn arrives while the suspend runs, EnsureSessionActor sees
  SUSPENDING, doesn't resume, and waits for RUNNING until it times out
  (2 minutes, "not reachable via atenet-router");
- if it arrives just before, the suspend checkpoints the actor under it.

The session transport now counts in-flight turns per session. A suspend
holds the session's lock while it checks and suspends; a new turn registers,
then waits out a suspend in progress. So a scheduled suspend skips a session
with a newer turn in flight, and a turn never starts under a suspend. For
suspends this controller didn't start (another replica), EnsureSessionActor
waits out SUSPENDING and then resumes.
---
 .../a2a/substrate_sandbox_transport.go        | 73 ++++++++++++++++++-
 .../a2a/substrate_sandbox_transport_test.go   | 43 +++++++++++
 .../sandboxbackend/substrate/agent_actor.go   | 14 ++++
 3 files changed, 128 insertions(+), 2 deletions(-)

diff --git a/go/core/internal/a2a/substrate_sandbox_transport.go b/go/core/internal/a2a/substrate_sandbox_transport.go
index 8d9ed64..359425d 100644
--- a/go/core/internal/a2a/substrate_sandbox_transport.go
+++ b/go/core/internal/a2a/substrate_sandbox_transport.go
@@ -26,6 +26,71 @@ type substrateSandboxSessionRoundTripper struct {
 	actorBackend *substrate.SandboxAgentActorBackend
 	base         http.RoundTripper
 	db           database.Client
+	turns        sessionTurns
+}
+
+// sessionTurns tracks in-flight turns per session. Every turn's end schedules
+// a suspend, which must never land on a newer turn of the same session (a
+// HITL approval, or the next message, sent the moment a response closes). A
+// suspend holds the session's lock while it checks for turns and suspends; a
+// new turn registers, then waits out any suspend in progress. So a turn starts
+// either before the suspend, which then skips, or after it, and resumes.
+type sessionTurns struct {
+	mu sync.Mutex
+	m  map[string]*sessionTurn
+}
+
+type sessionTurn struct {
+	sync.Mutex     // held while this session's actor is being suspended
+	active     int // guarded by sessionTurns.mu
+}
+
+func (s *sessionTurns) begin(id string) {
+	s.mu.Lock()
+	if s.m == nil {
+		s.m = map[string]*sessionTurn{}
+	}
+	st := s.m[id]
+	if st == nil {
+		st = &sessionTurn{}
+		s.m[id] = st
+	}
+	st.active++
+	s.mu.Unlock()
+	st.Lock()
+	st.Unlock() //nolint:staticcheck // only waiting out a suspend in progress
+}
+
+func (s *sessionTurns) end(id string) {
+	s.mu.Lock()
+	if st := s.m[id]; st != nil && st.active > 0 {
+		st.active--
+	}
+	s.mu.Unlock()
+}
+
+// suspendIdle runs suspend unless a turn of the session is in flight.
+func (s *sessionTurns) suspendIdle(id string, suspend func()) {
+	s.mu.Lock()
+	st := s.m[id]
+	if st != nil && st.active > 0 {
+		s.mu.Unlock()
+		return
+	}
+	if st != nil {
+		st.Lock()
+	}
+	s.mu.Unlock()
+	suspend()
+	if st == nil {
+		return
+	}
+	st.Unlock()
+	s.mu.Lock()
+	if st.active == 0 && s.m[id] == st {
+		delete(s.m, id)
+	}
+	s.mu.Unlock()
 }
 
