 		}
 	}
 
+	// A suspend still in flight (e.g. the previous turn's, from another
+	// controller replica) holds the actor's lock: let it finish, then resume.
+	for actor.GetStatus() == ateapipb.Actor_STATUS_SUSPENDING {
+		select {
+		case <-ctx.Done():
+			return sandboxbackend.EnsureResult{}, fmt.Errorf("substrate actor %q still suspending: %w", actorID, ctx.Err())
+		case <-time.After(defaultActorReachabilityInterval):
+		}
+		if actor, err = b.client.GetActor(ctx, atespace, actorID); err != nil {
+			return sandboxbackend.EnsureResult{}, fmt.Errorf("substrate GetActor %q: %w", actorID, err)
+		}
+	}
+
 	switch actor.GetStatus() {
 	case ateapipb.Actor_STATUS_SUSPENDED, ateapipb.Actor_STATUS_UNSPECIFIED,
 		ateapipb.Actor_STATUS_PAUSED, ateapipb.Actor_STATUS_PAUSING:
