@@ -93,6 +160,7 @@ func (t *substrateSandboxSessionRoundTripper) RoundTrip(req *http.Request) (*htt
 
 	resp, err := actorRT.RoundTrip(req)
 	if err != nil {
+		t.turns.end(sessionID)
 		t.scheduleSuspendSession(sessionID)
 		return nil, err
 	}
@@ -102,6 +170,7 @@ func (t *substrateSandboxSessionRoundTripper) RoundTrip(req *http.Request) (*htt
 	resp.Body = &suspendSessionActorOnClose{
 		ReadCloser: resp.Body,
 		suspend: func() {
+			t.turns.end(sessionID)
 			t.scheduleSuspendSession(sessionID)
 		},
 	}
@@ -136,11 +205,11 @@ func (t *substrateSandboxSessionRoundTripper) scheduleSuspendSession(sessionID s
 	if t == nil || t.actorBackend == nil || t.sandboxAgent == nil {
 		return
 	}
-	go func() {
+	go t.turns.suspendIdle(sessionID, func() {
 		ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
 		defer cancel()
 		_ = t.actorBackend.SuspendSessionActor(ctx, t.sandboxAgent, sessionID)
-	}()
+	})
 }
 
