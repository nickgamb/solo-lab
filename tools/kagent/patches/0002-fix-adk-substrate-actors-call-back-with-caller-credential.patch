From 2ff9be6207dfbc1fd485c2e971581c1fe77984ff Mon Sep 17 00:00:00 2001
From: Nick Gamb <nick.gamb@solo.io>
Date: Mon, 28 Sep 2026 14:22:15 -0700
Subject: [PATCH] fix(adk): Substrate actors call kagent back with the caller's
 credential

A declarative agent calls the kagent controller back (sessions, task store)
with its projected ServiceAccount token (/var/run/secrets/tokens/kagent-token).
Agent Substrate actors have no projected volumes, so a SandboxAgent calls back
with no Authorization at all. The unsecure authenticator doesn't mind; in
trusted-proxy mode every callback is a 401, so no SandboxAgent can hold a
conversation ("failed to save task state: status 401").

When the agent has no token of its own, the Go ADK now authenticates the
callback with the bearer token of the inbound A2A request it is serving:
the credential kagent itself forwarded to the agent for this user. Nothing
new is minted or stored (in particular nothing is baked into Substrate
snapshots), X-Agent-Name / X-User-Id are unchanged, and agents that have a
ServiceAccount token keep using it.
---
 go/adk/pkg/auth/token.go      | 26 ++++++++++++++++++++++
 go/adk/pkg/auth/token_test.go | 42 +++++++++++++++++++++++++++++++++++
 2 files changed, 68 insertions(+)
 create mode 100644 go/adk/pkg/auth/token_test.go

diff --git a/go/adk/pkg/auth/token.go b/go/adk/pkg/auth/token.go
index acce726..1b363dc 100644
--- a/go/adk/pkg/auth/token.go
+++ b/go/adk/pkg/auth/token.go
@@ -4,8 +4,11 @@ import (
 	"context"
 	"net/http"
 	"os"
+	"strings"
 	"sync"
 	"time"
+
+	"github.com/a2aproject/a2a-go/a2asrv"
 )
 
 type contextKey int
@@ -76,12 +79,35 @@ func (s *KAgentTokenService) AddHeaders(req *http.Request) {
 	req.Header.Set("X-Agent-Name", s.appName)
 	if token := s.GetToken(); token != "" {
 		req.Header.Set("Authorization", "Bearer "+token)
+	} else if token := callerBearerToken(req.Context()); token != "" {
+		// No token of our own (an Agent Substrate actor has no projected
+		// ServiceAccount token): call back with the credential kagent sent
+		// the A2A request with, i.e. act for the caller.
+		req.Header.Set("Authorization", "Bearer "+token)
 	}
 	if userID := UserIDFromContext(req.Context()); userID != "" {
 		req.Header.Set("X-User-Id", userID)
 	}
 }
 
+// callerBearerToken returns the bearer token of the inbound A2A request that
+// ctx belongs to, if any.
+func callerBearerToken(ctx context.Context) string {
+	callCtx, ok := a2asrv.CallContextFrom(ctx)
+	if !ok || callCtx.RequestMeta() == nil {
+		return ""
+	}
+	vals, ok := callCtx.RequestMeta().Get("authorization")
+	if !ok || len(vals) == 0 {
+		return ""
+	}
+	scheme, token, ok := strings.Cut(strings.TrimSpace(vals[0]), " ")
+	if !ok || !strings.EqualFold(scheme, "Bearer") {
+		return ""
+	}
+	return strings.TrimSpace(token)
+}
+
 // readToken reads the token from the file
 func (s *KAgentTokenService) readToken() (string, error) {
 	data, err := os.ReadFile(kagentTokenPath)
diff --git a/go/adk/pkg/auth/token_test.go b/go/adk/pkg/auth/token_test.go
new file mode 100644
index 0000000..42a08b8
--- /dev/null
+++ b/go/adk/pkg/auth/token_test.go
@@ -0,0 +1,42 @@
+package auth
+
+import (
+	"context"
+	"net/http"
+	"testing"
+
+	"github.com/a2aproject/a2a-go/a2asrv"
+)
+
+func TestAddHeaders_Authorization(t *testing.T) {
+	inbound := func(authz string) context.Context {
+		ctx, _ := a2asrv.WithCallContext(context.Background(),
+			a2asrv.NewRequestMeta(map[string][]string{"authorization": {authz}}))
+		return ctx
+	}
+	tests := []struct {
+		name     string
+		own      string
+		ctx      context.Context
+		expected string
+	}{
+		{"own token wins", "sa-token", inbound("Bearer user-token"), "Bearer sa-token"},
+		{"no own token: caller's bearer", "", inbound("Bearer user-token"), "Bearer user-token"},
+		{"no own token, non-bearer caller", "", inbound("Basic abc"), ""},
+		{"no own token, no caller", "", context.Background(), ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			s := NewKAgentTokenService("ns__NS__agent")
+			s.token = tt.own
+			req, _ := http.NewRequestWithContext(tt.ctx, http.MethodGet, "http://kagent/api/tasks", nil)
+			s.AddHeaders(req)
+			if got := req.Header.Get("Authorization"); got != tt.expected {
+				t.Errorf("Authorization = %q, want %q", got, tt.expected)
+			}
+			if got := req.Header.Get("X-Agent-Name"); got != "ns__NS__agent" {
+				t.Errorf("X-Agent-Name = %q", got)
+			}
+		})
+	}
+}
