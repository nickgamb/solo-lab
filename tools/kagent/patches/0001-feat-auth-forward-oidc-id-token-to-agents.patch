diff --git a/go/core/internal/httpserver/auth/proxy_authn.go b/go/core/internal/httpserver/auth/proxy_authn.go
index 6ed7154..1ee8d37 100644
--- a/go/core/internal/httpserver/auth/proxy_authn.go
+++ b/go/core/internal/httpserver/auth/proxy_authn.go
@@ -8,14 +8,27 @@ import (
 	"net/http"
 	"net/url"
 	"strings"
+	"time"
 
 	"github.com/kagent-dev/kagent/go/core/pkg/auth"
 )
 
 var ErrUnauthenticated = errors.New("unauthenticated: missing or invalid Authorization header")
 
+// IDTokenHeader is the header an agent receives the signed-in user's OIDC ID
+// token on (A2A), when ID token forwarding is configured.
+const IDTokenHeader = "X-Id-Token"
+
 type ProxyAuthenticator struct {
 	userIDClaim string
+
+	// Optional ID token forwarding. The proxy in front of kagent authenticates
+	// the user; the ID token is the identity assertion some downstream flows
+	// need as their subject (e.g. Cross App Access, where an IdP issues an
+	// ID-JAG only for an ID token issued to the requesting app).
+	idTokenHeader   string
+	idTokenCookie   string
+	idTokenAudience string
 }
 
 func NewProxyAuthenticator(userIDClaim string) *ProxyAuthenticator {
@@ -25,6 +38,71 @@ func NewProxyAuthenticator(userIDClaim string) *ProxyAuthenticator {
 	return &ProxyAuthenticator{userIDClaim: userIDClaim}
 }
 
+// WithIDToken enables forwarding the user's OIDC ID token to agents as
+// X-Id-Token. The token is read from header (preferred) or cookie. When
+// audience is set, the token must be issued to that client (aud or azp).
+func (a *ProxyAuthenticator) WithIDToken(header, cookie, audience string) *ProxyAuthenticator {
+	a.idTokenHeader, a.idTokenCookie, a.idTokenAudience = header, cookie, audience
+	return a
+}
+
+// boundIDToken returns the request's ID token only if it is bound to the
+// authenticated user: same subject as the access token, issued to the
+// configured client, and not expired. Like the rest of trusted-proxy mode it
+// does not verify signatures (the proxy and the ID token's consumer do); the
+// binding check stops a caller splicing another user's ID token onto their
+// own session. Anything that fails the check is dropped, never forwarded.
+func (a *ProxyAuthenticator) boundIDToken(reqHeaders http.Header, accessClaims map[string]any) string {
+	if a.idTokenHeader == "" && a.idTokenCookie == "" {
+		return ""
+	}
+	raw := ""
+	if a.idTokenHeader != "" {
+		raw = strings.TrimSpace(reqHeaders.Get(a.idTokenHeader))
+		raw = strings.TrimPrefix(raw, "Bearer ")
+	}
+	if raw == "" && a.idTokenCookie != "" {
+		req := http.Request{Header: reqHeaders}
+		if c, err := req.Cookie(a.idTokenCookie); err == nil {
+			raw = c.Value
+		}
+	}
+	if raw == "" {
+		return ""
+	}
+	claims, err := parseJWTPayload(raw)
+	if err != nil {
+		return ""
+	}
+	if sub, _ := claims["sub"].(string); sub == "" || sub != accessClaims["sub"] {
+		return ""
+	}
+	if exp, ok := claims["exp"].(float64); !ok || time.Unix(int64(exp), 0).Before(time.Now()) {
+		return ""
+	}
+	if a.idTokenAudience != "" && !claimHasAudience(claims, a.idTokenAudience) {
+		return ""
+	}
+	return raw
+}
+
+func claimHasAudience(claims map[string]any, want string) bool {
+	if azp, _ := claims["azp"].(string); azp == want {
+		return true
+	}
+	switch aud := claims["aud"].(type) {
+	case string:
+		return aud == want
+	case []any:
+		for _, v := range aud {
+			if s, _ := v.(string); s == want {
+				return true
+			}
+		}
+	}
+	return false
+}
+
 func (a *ProxyAuthenticator) Authenticate(ctx context.Context, reqHeaders http.Header, query url.Values) (auth.Session, error) {
 	authHeader := reqHeaders.Get("Authorization")
 	agentID := reqHeaders.Get("X-Agent-Name")
@@ -75,6 +153,7 @@ func (a *ProxyAuthenticator) Authenticate(ctx context.Context, reqHeaders http.H
 			Claims: rawClaims,
 		},
 		authHeader: authHeader,
+		idToken:    a.boundIDToken(reqHeaders, rawClaims),
 	}, nil
 }
 
@@ -95,6 +174,9 @@ func (a *ProxyAuthenticator) UpstreamAuth(r *http.Request, session auth.Session,
 		if userID := simpleSession.P.User.ID; userID != "" {
 			r.Header.Set("X-User-Id", userID)
 		}
+		if simpleSession.idToken != "" {
+			r.Header.Set(IDTokenHeader, simpleSession.idToken)
+		}
 	}
 	return nil
 }
diff --git a/go/core/internal/httpserver/auth/proxy_authn_test.go b/go/core/internal/httpserver/auth/proxy_authn_test.go
index b6af326..f9a7048 100644
--- a/go/core/internal/httpserver/auth/proxy_authn_test.go
+++ b/go/core/internal/httpserver/auth/proxy_authn_test.go
@@ -296,3 +296,55 @@ func TestProxyAuthenticator_UpstreamAuth(t *testing.T) {
 		t.Errorf("X-User-Id header = %q, want %q", got, "user123")
 	}
 }
+
+// ID token forwarding: the user's OIDC ID token reaches agents as X-Id-Token
+// only when it is bound to the authenticated user.
+func TestProxyAuthenticator_ForwardsBoundIDToken(t *testing.T) {
+	future := float64(4102444800) // 2100-01-01
+	access := createTestJWT(map[string]any{"sub": "user-1", "preferred_username": "bob"})
+	good := createTestJWT(map[string]any{"sub": "user-1", "aud": "kagent", "azp": "kagent", "exp": future})
+	tests := []struct {
+		name    string
+		header  string
+		cookie  string
+		aud     string
+		reqHdr  map[string]string
+		wantFwd string // "" = not forwarded
+	}{
+		{"not configured: nothing forwarded", "", "", "", map[string]string{"X-Forwarded-Id-Token": good}, ""},
+		{"from header", "X-Forwarded-Id-Token", "", "kagent", map[string]string{"X-Forwarded-Id-Token": good}, good},
+		{"from cookie (Envoy/kgateway OAuth2 IdToken)", "", "IdToken", "kagent", map[string]string{"Cookie": "OauthHMAC=x; IdToken=" + good}, good},
+		{"header wins over cookie", "X-Forwarded-Id-Token", "IdToken", "", map[string]string{"X-Forwarded-Id-Token": good, "Cookie": "IdToken=other"}, good},
+		{"other user's ID token is dropped", "X-Forwarded-Id-Token", "", "", map[string]string{
+			"X-Forwarded-Id-Token": createTestJWT(map[string]any{"sub": "user-2", "aud": "kagent", "exp": future})}, ""},
+		{"wrong client is dropped", "X-Forwarded-Id-Token", "", "kagent", map[string]string{
+			"X-Forwarded-Id-Token": createTestJWT(map[string]any{"sub": "user-1", "aud": "other-app", "azp": "other-app", "exp": future})}, ""},
+		{"expired is dropped", "X-Forwarded-Id-Token", "", "", map[string]string{
+			"X-Forwarded-Id-Token": createTestJWT(map[string]any{"sub": "user-1", "aud": "kagent", "exp": float64(1)})}, ""},
+		{"not a JWT is dropped", "X-Forwarded-Id-Token", "", "", map[string]string{"X-Forwarded-Id-Token": "garbage"}, ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			a := authimpl.NewProxyAuthenticator("preferred_username").WithIDToken(tt.header, tt.cookie, tt.aud)
+			h := http.Header{}
+			h.Set("Authorization", "Bearer "+access)
+			for k, v := range tt.reqHdr {
+				h.Set(k, v)
+			}
+			session, err := a.Authenticate(context.Background(), h, url.Values{})
+			if err != nil {
+				t.Fatalf("Authenticate: %v", err)
+			}
+			up, _ := http.NewRequest(http.MethodPost, "http://agent/", nil)
+			if err := a.UpstreamAuth(up, session, session.Principal()); err != nil {
+				t.Fatalf("UpstreamAuth: %v", err)
+			}
+			if got := up.Header.Get(authimpl.IDTokenHeader); got != tt.wantFwd {
+				t.Fatalf("X-Id-Token forwarded = %q, want %q", got, tt.wantFwd)
+			}
+			if up.Header.Get("Authorization") != "Bearer "+access {
+				t.Fatalf("Authorization must stay the user's access token")
+			}
+		})
+	}
+}
